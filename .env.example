# Copie para ".env" só para rodar LOCALMENTE. NUNCA publique o .env.
# No Vercel, cadastre estas variáveis em Settings → Environment Variables.

# Chave gratuita: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_KEY=COLE_SUA_CHAVE_AQUI

# String de conexão do Neon (o Vercel cria DATABASE_URL sozinho ao conectar o Neon)
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Opcional: libera GET /api/feedback/exportar?token=... (sem isso a rota fica desativada)
ADMIN_TOKEN=

# Opcional: sal usado para anonimizar o IP dos visitantes (LGPD)
IP_SALT=troque-este-valor

PORT=3000
